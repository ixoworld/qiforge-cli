import type { OracleConfig } from '@ixo/oracle-runtime-workers';

const name = {{oracleNameJson}};
const org = {{orgJson}};
const description = {{descriptionJson}};

/**
 * Oracle identity and the prompt slots this project owns. Imported by
 * `index.ts` and by `config.test.ts`.
 *
 * The runtime's prompt composer (`@ixo/oracle-runtime-workers/prompt`) owns
 * the rest of the system prompt: the capability catalog and how to load
 * capabilities, tool and memory policy, the user's preferences and the date.
 * Add only what the runtime lacks. `opening` replaces the composer's
 * generated identity sentence verbatim, so it must still say who the oracle
 * is.
 *
 * `entityDid` is not set here: the runtime reads it from the
 * `ORACLE_ENTITY_DID` var in wrangler.jsonc.
 */
export const config = {
  name,
  org,
  description,
  prompt: {
    opening: `You are ${name}, operated by ${org}. ${description}`,
    communicationStyle: [
      '- Lead with the answer or the result, not preamble.',
      "- Match the depth to the task and the user's preferences.",
      '- Keep verified outcomes apart from inference, and say which is which.',
    ].join('\n'),
    capabilities:
      'Use a tool when it changes the result: live facts, something you cannot verify from what you already have, or an action that has to actually happen.',
  },
} satisfies OracleConfig;
