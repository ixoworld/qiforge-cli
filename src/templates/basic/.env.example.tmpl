# Copy to .env and fill in. createOracleApp validates env via every loaded
# plugin's Zod schema at boot — missing required keys fail fast with a clear
# error pointing at the plugin that needed them.

# ── App / runtime ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
ORACLE_NAME={{name}}
ORACLE_ENTITY_DID=did:ixo:entity:CHANGE_ME
NETWORK={{network}}
SQLITE_DATABASE_PATH=./.data/sqlite

# ── Matrix (required) ─────────────────────────────────────────────────────
MATRIX_BASE_URL=https://your-matrix-homeserver.example
MATRIX_RECOVERY_PHRASE=
MATRIX_ORACLE_ADMIN_USER_ID=@oracle:your-homeserver
MATRIX_ORACLE_ADMIN_PASSWORD=
MATRIX_ORACLE_ADMIN_ACCESS_TOKEN=
MATRIX_ACCOUNT_ROOM_ID=
MATRIX_VALUE_PIN=
MATRIX_STORE_PATH=./.data/matrix-storage

# ── Blockchain / IXO ─────────────────────────────────────────────────────
BLOCKSYNC_GRAPHQL_URL=https://devnet-blocksync-graphql.ixo.earth/graphql
RPC_URL=https://devnet.ixo.earth/rpc/
SECP_MNEMONIC=

# ── LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=openrouter
OPEN_ROUTER_API_KEY=

# ── Redis (optional — enables credits + claim-processing + token-limit) ──
# REDIS_URL=redis://localhost:6379

# ── Memory Engine (optional — enables memory plugin) ─────────────────────
# MEMORY_ENGINE_URL=https://memory-engine.example/mcp

# ── Subscription API (optional) ──────────────────────────────────────────
# SUBSCRIPTION_URL=

# ── LangSmith tracing (optional) ─────────────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT={{name}}
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Slack plugin (optional) ──────────────────────────────────────────────
# SLACK_BOT_OAUTH_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_USE_SOCKET_MODE=true

# ── Composio plugin (optional) ───────────────────────────────────────────
# COMPOSIO_API_KEY=

# ── Firecrawl plugin (optional) ──────────────────────────────────────────
# FIRECRAWL_API_KEY=

# ── Sandbox plugin (optional) ────────────────────────────────────────────
# SANDBOX_MCP_URL=

# ── Skills plugin (optional) ─────────────────────────────────────────────
# SKILLS_API_URL=
