{
  "name": "{{workerName}}",
  "version": "0.1.0",
  "description": {{descriptionJson}},
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev -c wrangler.jsonc -c wrangler.gateway.jsonc",
    "deploy": "wrangler deploy -c wrangler.gateway.jsonc && wrangler deploy -c wrangler.jsonc",
    "deploy:gateway": "wrangler deploy -c wrangler.gateway.jsonc",
    "deploy:oracle": "wrangler deploy -c wrangler.jsonc",
    "build": "wrangler deploy --dry-run --outdir dist/gateway -c wrangler.gateway.jsonc && wrangler deploy --dry-run --outdir dist/oracle -c wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types -c wrangler.jsonc"
  },
  "dependencies": {
    "@ixo/matrix-bot-workers-sdk": "{{botSdkVersion}}",
    "@ixo/oracle-runtime-workers": "{{runtimeVersion}}",
    "zod": "{{zodVersion}}"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@cloudflare/workers-types": "{{workersTypesVersion}}",
    "@types/node": "^22.10.7",
    "typescript": "^5.9.3",
    "vitest": "{{vitestVersion}}",
    "wrangler": "{{wranglerVersion}}"
  }
}
