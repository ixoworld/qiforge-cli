import type { PluginContext } from '@ixo/oracle-runtime-workers';
import { describe, expect, it } from 'vitest';
import { {{nameClass}}Plugin, echo } from './{{nameKebab}}.plugin';

/** The boot-time context the runtime hands `getTools`. */
const pluginContext: PluginContext = {
  config: {},
  identity: {
    name: 'Test Oracle',
    org: 'Test Org',
    description: 'An oracle under test.',
    entityDid: 'did:ixo:entity:00000000000000000000000000000000',
  },
  availablePlugins: new Set(['{{nameKebab}}']),
  logger: { log() {}, warn() {}, error() {} },
};

describe('{{nameClass}}Plugin', () => {
  it('exposes its tool', () => {
    const tools = new {{nameClass}}Plugin().getTools(pluginContext);
    expect(tools.map((t) => t.name)).toEqual(['{{nameSnake}}_echo']);
  });

  it('echoes the supplied message', () => {
    expect(echo({ message: 'hi' })).toEqual({ echoed: 'hi' });
  });

  it('declares a schema that rejects malformed input', () => {
    const [echoTool] = new {{nameClass}}Plugin().getTools(pluginContext);
    expect(echoTool?.schema.safeParse({ message: 'hi' }).success).toBe(true);
    expect(echoTool?.schema.safeParse({}).success).toBe(false);
  });
});
