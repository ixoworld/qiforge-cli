import {
  OraclePlugin,
  type PluginContext,
  type PluginManifest,
  type PluginTool,
  tool,
} from '@ixo/oracle-runtime-workers';
import { z } from 'zod';

const NAME = '{{nameKebab}}';
const VERSION = '0.1.0';

/**
 * Plugin-owned env vars. The runtime merges this schema into the env schema
 * it validates at boot and hands the parsed values to the plugin as
 * `ctx.config`. On Workers they come from the wrangler `vars` (non-secret)
 * or from secrets (`.dev.vars` locally, `wrangler secret put` deployed).
 */
const configSchema = z.object({});

const manifest: PluginManifest = {
  title: '{{nameClass}}',
  summary: 'TODO: one-sentence summary of what this plugin does.',
  whenToUse: ['TODO: describe when the agent should reach for this plugin.'],
  whenNotToUse: ['TODO: list cases where the agent should NOT call this plugin.'],
  examples: [
    {
      user: 'TODO: example user utterance.',
      tool: '{{nameSnake}}_echo',
      args: { message: 'hello' },
    },
  ],
  tags: ['{{nameKebab}}'],
  category: 'data',
  // `on-demand`: hidden behind `load_capability` until a turn needs it.
  visibility: 'on-demand',
  stability: 'experimental',
};

export const echoSchema = z.object({
  message: z.string().describe('Message to echo back.'),
});

/** The sample tool's logic, kept apart from the wiring so tests call it directly. */
export function echo({ message }: z.infer<typeof echoSchema>): { echoed: string } {
  return { echoed: message };
}

/**
 * {{nameClass}} plugin — scaffolded by `qiforge-cli plugin new {{nameKebab}}`.
 *
 * Replace the sample tool with the real capability. The other hooks
 * (`getRequestTools`, `getSubAgents`, `getMiddlewares`, `getRoutes`,
 * `getAuthExcludedRoutes`, `getSharedState`, `getDecisions`, …) are on
 * `OraclePlugin` in `@ixo/oracle-runtime-workers`. Keep durable per-user
 * state in `ctx.kv`, never on the instance: one instance serves every user
 * in the isolate.
 */
export class {{nameClass}}Plugin extends OraclePlugin {
  readonly name = NAME;

  readonly version = VERSION;

  readonly manifest = manifest;

  override readonly configSchema = configSchema;

  override autoDetect(): boolean {
    return true;
  }

  override getTools(_ctx: PluginContext): PluginTool[] {
    return [
      tool(
        // The runtime validates `args` against `schema` before the call; the
        // parse here narrows `unknown` to the schema's type.
        async (args) => echo(echoSchema.parse(args)),
        {
          name: '{{nameSnake}}_echo',
          description: 'Echoes the provided message. Replace with a real tool.',
          schema: echoSchema,
          // No external effect: safe to run again if a turn resumes after a reset.
          effect: 'read',
        },
      ),
    ];
  }
}
